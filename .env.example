# DeepSeek API Proxy Configuration
# Copy this file to .env and customize runtime settings

# ── Client API authentication (/v1/*) ────────────────────────
# Create and revoke client API keys in WebUI > Settings.
# Key hashes are stored in data/api_keys.sqlite3; keys are shown only once.
# Legacy API_KEYS / DEEPSEEK_API_KEY values are imported once on first startup.

# Only for local development. Do NOT enable on a public server.
ALLOW_UNAUTHENTICATED_API=false

# Accounts are managed in WebUI > Account Pool or this JSON file.
# Keep this file private; it contains raw DeepSeek tokens and cookies.
ACCOUNT_STORE_PATH=data/accounts.json

# Server port (default: 8080)
PORT=8080

# The single model name this proxy serves: what /v1/models returns and what
# API responses report. It does not select an upstream model — there is only
# one. Reasoning is controlled by THINKING below, not by this name.
MODEL_NAME=deepseek-chat

# ── Capabilities (v3.3.8) ─────────────────────────────────────
# DeepSeek merged the quick and expert modes: the upstream serves ONE chat
# model and rewrites any `model_type` back to "default"
# (client/settings?scope=model reports 专家模式 enabled=false, switchable=false).
# This proxy therefore serves one model too, and the behaviour formerly called
# "expert mode" is produced solely by thinking_enabled, web search by
# search_enabled. Those two are the real
# switches; `model_type` survives only as a protocol field.

# DEPRECATED (kept for backward compatibility, prefer THINKING):
# "expert" = force thinking ON, "quick" = force thinking OFF, "auto" = ignore.
MODE=auto

# Thinking: "auto" (respect client), "enabled" (force on), "disabled" (force off)
# This is THE switch for reasoning — there is no separate "thinking model" to
# pick. "enabled" makes the one model emit a reasoning chain (OpenAI
# `reasoning_content`, Anthropic `thinking` blocks) before the answer;
# "disabled" gives a direct answer with lower latency.
THINKING=auto

# Search / Web Search: "auto" (respect client), "enabled" (force on), "disabled" (force off)
# Controls search_enabled for web search capability.
SEARCH=auto

# Admin panel password (for /webui management interface)
# If not set, default is "admin". Change this before exposing the service.
# The server refuses to start on a public bind (HOST=0.0.0.0) with a weak
# password unless ALLOW_INSECURE_PUBLIC_DEFAULTS=true.
DEEPSEEK_ADMIN_PASSWORD=admin

# Stateless admin sessions (REQUIRED on serverless/Vercel). Login tokens are
# HMAC-signed with this secret so any instance can verify them; without it,
# tokens live in process memory and the dashboard bounces back to /login
# when requests land on a different instance. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN_SECRET=

# ── Bind address (v2.2.0) ─────────────────────────────────────
# Where to listen. Default is loopback for safety. Use 0.0.0.0 ONLY
# behind a reverse proxy that enforces auth.
HOST=127.0.0.1
# PORT=8080

# Acknowledge risk explicitly when binding publicly with default creds.
# Default false. Set true to bypass the startup safety check (NOT recommended).
ALLOW_INSECURE_PUBLIC_DEFAULTS=false

# ── CORS allow-list (v2.2.0) ──────────────────────────────────
# Comma-separated list of allowed origins for browser-based clients.
# Empty = same-origin only (the safe default).
# ALLOWED_ORIGINS=https://app.example.com,https://chat.example.com
# ALLOW_CORS_CREDENTIALS=true

# ── Trusted proxies (v2.2.0) ──────────────────────────────────
# Comma-separated list of IPs / CIDR ranges that are allowed to set
# X-Forwarded-For for the admin login throttle. Empty = no proxy is
# trusted, request.client.host is always used.
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8,::1

# ── Encryption key for data/accounts.json (v2.2.0) ────────────
# When set, DeepSeek tokens/cookies are encrypted at rest using Fernet
# (AES-128-CBC + HMAC-SHA256). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Existing plaintext files are auto-migrated to encrypted form on first
# startup; a `accounts.json.v1.bak` is left for rollback.
# DEEPSEEK_ENCRYPTION_KEY=

# ── Logging (v2.2.0) ──────────────────────────────────────────
# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# Log format: json (production) or text (development, default)
LOG_FORMAT=json

# ── Client rate limiting (v2.2.0) ─────────────────────────────
# Per-API-key requests-per-minute. 0 = unlimited.
CLIENT_RPM_PER_KEY=60
# Per-client-IP requests-per-minute. 0 = unlimited.
CLIENT_RPM_PER_IP=120
# Set false to disable all rate limiting (e.g. trusted internal network).
ENABLE_RATE_LIMIT=true

# ── Model routing (v2.2.0; optional since v3.3.8) ─────────────
# This proxy serves ONE model. /v1/models lists MODEL_NAME only, and whether it
# thinks is decided by THINKING above — you do NOT pick a different model name
# to get reasoning. Leave MODEL_ROUTES unset for the normal setup.
#
# It remains available as an advanced override: a JSON map from a public model
# name (what clients put in the `model` field) to a capability preset. Setting
# it changes the names advertised on /v1/models to its keys.
#   "default" / "quick"   → thinking OFF (fast, no reasoning chain)
#   "thinking" / "expert" → thinking ON  (the former "expert mode" behaviour)
#   {"model_type":"default","thinking":"enabled","search":"disabled"}
#              → full per-route control; `model_type` is a protocol field now
#                and is normalised to "default" upstream.
# When a client's model is not in this map, THINKING / SEARCH env vars apply.
# Legacy names (deepseek-reasoner, …) are accepted as aliases of MODEL_NAME
# whether or not this is set — they no longer change behaviour.
# MODEL_ROUTES={"my-model":"thinking"}

# ── Multi-turn conversation cache (v2.2.0) ────────────────────
# TTL (seconds) for the caller-scoped, account-bound chat-session cache.
# Reuse requires X-Conversation-Id, OpenAI's top-level `user`, or Anthropic
# metadata.user_id; otherwise every request starts a fresh upstream session.
# 0 = always start a fresh session.
# Default raised to 1800 in v3.2.4 to keep long coding-agent sessions
# threaded. Cached turns send incremental (delta) prompts upstream
# instead of resending the full history (see AGENTS.md §5).
SESSION_CACHE_TTL=1800

# ── Upstream concurrency (v3.2.4) ─────────────────────────────
# Max number of simultaneous upstream DeepSeek calls across ALL
# accounts. Extra requests queue (wait) instead of failing. Coding
# agents (opencode, Claude Code, ...) spawn parallel sub-agents that
# otherwise flood DeepSeek and trigger account mutes. Min 1.
DEEPSEEK_MAX_CONCURRENCY=2

# ── Anti-detection ───────────────────────────────────────────
# TLS / JA3 impersonation profile. Passed to curl_cffi.Session.
# Pick a profile close to a current Chrome Stable to match what real users send.
# Values: chrome120, chrome123, chrome124, chrome131, chrome133, chrome136, ...
# (depends on the curl_cffi version installed). chrome131 is a safe default
# in mid-2026.
DEEPSEEK_IMPERSONATE=chrome131

# Inter-call jitter (seconds). Sleep a small uniform-random delay before
# each upstream call to break perfectly-timed automation patterns and
# reduce the chance of tripping the upstream rate limiter.
# Default 0.4; set 0 to disable.
DEEPSEEK_JITTER_SECS=0.4

# Backoff delays (seconds) before retrying after an upstream rate limit
# (upstream responds with finish_reason=rate_limit_reached). Each entry
# consumes one retry; after the last one the request fails with 429.
# Comma-separated; empty disables retrying entirely.
DEEPSEEK_RATE_LIMIT_RETRY_DELAYS=5,15
# ── Credential refresh (fork feature) ───────────────────────
# DeepSeek web tokens and cookies expire quickly. Instead of failing until you
# paste a fresh token in the WebUI, the proxy can mint new credentials with the
# ones it already holds:
#   proactive - an account is refreshed when its token comes within
#               TOKEN_REFRESH_AHEAD_SECS of the JWT "exp" claim (checked when
#               the account is picked for a request; runs in the background)
#   reactive  - a refresh is attempted as soon as the upstream rejects the
#               credentials (HTTP 200 + {"code":40003,
#               "msg":"Authorization Failed (invalid token)"}); an in-flight
#               request retries once with the new credentials
#   manual    - WebUI -> Accounts -> Refresh, or
#               POST /admin/api/accounts/{id}/refresh
# 1 = automatic refresh enabled (default); 0 = only the manual button works.
TOKEN_REFRESH_ENABLED=1
# Refresh this many seconds BEFORE the token actually expires. 0 = never
# refresh proactively (only react to an explicit rejection).
TOKEN_REFRESH_AHEAD_SECS=900
# Minimum seconds between two refresh attempts for the SAME account, so a
# moved/renamed upstream endpoint is not hammered once per request.
TOKEN_REFRESH_MIN_INTERVAL_SECS=300
# Comma-separated paths tried in order against https://chat.deepseek.com.
# This endpoint is not publicly documented and could not be confirmed from the
# server side (the SPA bundle is behind an AWS WAF JS challenge), so if
# DeepSeek moves it, add the new path here - no code change needed. The
# response shape is parsed tolerantly (data.biz_data.token / data.token /
# access_token / a localStorage {"value": ...} wrapper) and rotated cookies are
# merged into the existing jar.
DEEPSEEK_REFRESH_PATHS=/api/v0/auth/refresh,/api/v0/user/refresh_token
# Timeout for one refresh request, seconds.
DEEPSEEK_REFRESH_TIMEOUT_SECS=20

# ── Account store backend (fork feature; needed on serverless) ─
# On Vercel the container filesystem is ephemeral, so a refreshed token written
# to /tmp is gone on the next cold start. Bind a Vercel KV store to the project
# and both KV_REST_API_URL and KV_REST_API_TOKEN are injected into the runtime;
# KV then becomes the authoritative account store (Upstash-compatible REST) and
# ACCOUNT_STORE_PATH is still written as a best-effort mirror / fallback.
# Set them in the Vercel project (Storage -> KV -> Connect to project), not in
# this file:
#   KV_REST_API_URL=https://...reststore.aws:...upstash.com
#   KV_REST_API_TOKEN=...
# Key the account document lives under inside the store:
# KV_ACCOUNTS_KEY=ds2api:accounts.json
# With a KV backend keep DEEPSEEK_ENCRYPTION_KEY set: the same Fernet key
# encrypts credentials at rest in KV as it does in accounts.json.
